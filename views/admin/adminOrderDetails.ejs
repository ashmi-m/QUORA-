<!-- <%- include("../partials/admin/header", { active: "orders" }) %> -->

<div id="admin-modal-root">

  <div class="order-details-overlay" onclick="window.location.href='/admin/orders'"></div>

 
  <div class="order-details-modal">

    <button class="btn-close" onclick="window.location.href='/admin/orders'">✕</button>

    <div class="modal-header">
      <h2>Order Details</h2>
      <span class="order-id">#<%= order._id %></span>
    </div>

    <div class="meta-grid">
      <div><b>Date:</b> <%= order.createdAt.toDateString() %></div>
      <div><b>Payment:</b> <%= order.paymentMethod %></div>
      <div><b>Status:</b> <%= order.status %></div>
    </div>
    <div class="section">
      <h3>Customer Details</h3>
      <p><b>Name:</b> <%= order.userId.name %></p>
      <p><b>Email:</b> <%= order.userId.email %></p>
      <p><b>Phone:</b> <%= order.userId.phone %></p>
      <p>
        <b>Address:</b>
        <%= order.address.street %>,
        <%= order.address.city %>,
        <%= order.address.state %> - <%= order.address.pincode %>
      </p>
    </div>
    <div class="section">
      <h3>Products</h3>

      <% order.products.forEach((item, index) => { %>
        <div class="product-row">

          <img src="<%= item.productId.images?.[0] || '/placeholder.png' %>" />

          <div class="info">
            <h4><%= item.productId.productName || item.productId.name %></h4>
            <p>Qty: <%= item.quantity %></p>
            <p>Price: ₹<%= item.price %></p>
            <p class="line-total">₹<%= item.price * item.quantity %></p>
          </div>
          <form method="POST" action="/admin/orders/<%= order._id %>/update-product-status">
            <input type="hidden" name="productIndex" value="<%= index %>">
            <select name="status" onchange="this.form.submit()">
              <% ["Pending","Processing","Shipped","Delivered","Cancelled"].forEach(s => { %>
                <option value="<%= s %>" <%= item.status === s ? "selected" : "" %>>
                  <%= s %>
                </option>
              <% }) %>
            </select>
          </form>

        </div>
      <% }) %>
    </div>
    <div class="section summary">
      <h3>Payment Summary</h3>
      <div><span>Subtotal</span><span>₹<%= order.totalPrice %></span></div>
      <div><span>Delivery</span><span>₹<%= order.deliveryCharges %></span></div>
      <div class="total"><span>Total</span><span>₹<%= order.grandTotal %></span></div>
    </div>

  </div>
</div>
