<%- include("../../views/partials/admin/header",{active : 'editproducts' }) %>
<title>Edit Product</title>
<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet"/>

<style>
  body {
    margin: 0;
    font-family: 'Arial', sans-serif;
    background: #f5f5f5;
  }

  .sidebar {
    width: 220px;
    height: 100vh;
    background: #1a1a1a;
    color: #fff;
    position: fixed;
    padding-top: 20px;
  }

  .sidebar h2 {
    text-align: center;
    margin-bottom: 40px;
  }

  .sidebar ul {
    list-style: none;
    padding: 0;
  }

  .sidebar ul li {
    padding: 15px 20px;
    cursor: pointer;
  }

  .sidebar ul li:hover {
    background: #333;
  }

  .main-content {
    margin-left: 220px;
    padding: 30px;
  }

  .card {
    background: #fff;
    padding: 30px;
    border-radius: 8px;
    max-width: 800px;
    margin: auto;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .card h2 {
    margin-bottom: 20px;
    font-size: 24px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    padding: 10px;
    border-radius: 6px;
    border: 1px solid #ccc;
    font-size: 16px;
  }

  .image-upload-container {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .image-upload-container img {
    border-radius: 6px;
    border: 1px solid #ddd;
    padding: 4px;
  }

  .buttons {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }

  .buttons button {
    padding: 10px 20px;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    cursor: pointer;
  }

  .cancel-btn {
    background: #fff;
    color: #5c5cff;
    border: 1px solid #5c5cff;
  }

  .edit-btn {
    background: #5c5c00;
    color: #fff;
  }

  .preview-wrapper {
    position: relative;
    display: inline-block;
  }

  .preview-wrapper img {
    border-radius: 6px;
    border: 1px solid #ddd;
    padding: 4px;
    width: 80px;
    height: 80px;
    object-fit: cover;
  }

  .btn-delete {
    position: absolute;
    top: -8px;
    right: -8px;
    background: none;
    border: none;
    color: red;
    font-size: 16px;
    cursor: pointer;
  }

  /* MODAL */
  .crop-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.6);
    justify-content: center;
    align-items: center;
    z-index: 999;
  }

  .crop-box {
    background: #fff;
    padding: 20px;
    border-radius: 12px;
    width: 500px;
    max-width: 90%;
    text-align: center;
  }

  #cropImage {
    max-width: 100%;
    max-height: 400px;
  }

  .crop-actions {
    margin-top: 15px;
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .btn-save {
    background: #28a745;
    color: white;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
  }

  .btn-cancel {
    background: #dc3545;
    color: white;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
  }
</style>
</head>

<body>

  <div class="main-content">
    <div class="card">
      <h2>Edit Product</h2>

      <form action="/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">

        <div class="form-group">
          <label>Product Name</label>
          <input type="text" name="productName" value="<%= product.productName %>" required />
        </div>

        <div class="form-group">
          <label>Product Description</label>
          <textarea name="description" required><%= product.description %></textarea>
        </div>

        <div class="form-group">
          <label>Edit Photos</label>
          <input type="file" id="imageInput" style="margin-bottom:10px;" />
          <input type="hidden" name="croppedImages" id="croppedImages">
          <div class="image-upload-container">
            <% if (product.productImage && product.productImage.length > 0) { %>
              <% product.productImage.forEach((img, i) => { %>
                <div class="preview-wrapper" id="previewWrapper<%= i %>">
                  <img src="<%= img %>" width="80" alt="Product Image" />
                  <button type="button" class="btn-delete"
                    onclick="removeExistingImage('<%= img %>', '<%= i %>')">❌</button>
                  <input type="hidden" name="existingImages[]" value="<%= img %>">
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <div class="form-group">
          <label>Base Price</label>
          <input type="number" name="regularPrice" value="<%= product.regularPrice %>" required />
        </div>

        <div class="form-group">
          <label>Discount Price</label>
          <input type="number" name="salePrice" value="<%= product.salePrice || '' %>" />
        </div>

        <div class="form-group">
          <label>Category</label>
          <select name="category" required>
            <% categories.forEach(cat => { %>
              <option value="<%= cat._id %>"
                <%= product.category && product.category._id.toString() === cat._id.toString() ? "selected" : "" %>>
                <%= cat.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label>Brand</label>
          <select name="brand" required>
            <% brands.forEach(br => { %>
              <option value="<%= br._id %>"
                <%= product.brand && product.brand.toString() === br._id.toString() ? "selected" : "" %>>
                <%= br.brandName %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label>Stock</label>
          <input type="number" name="quantity" value="<%= product.quantity %>" required />
        </div>

        <div class="buttons">
          <a href="/admin/products">
            <button type="button" class="cancel-btn">Cancel</button>
          </a>
          <button type="submit" class="edit-btn">Save Changes</button>
        </div>

      </form>
     

    </div>
  </div>

 
  <div id="cropModal" class="crop-modal">
    <div class="crop-box">
      <img id="cropImage">
      <div class="crop-actions">
  
        <button type="button" id="cropSaveBtn" class="btn-save">Crop & Use</button>
        <button type="button" id="cropCancelBtn" class="btn-cancel">Cancel</button>
      </div>
    </div>
  </div>

 
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

  <script>
    function removeExistingImage(image, index) {
      const productId = "<%= product._id %>";
      fetch('/admin/delete-product-image', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId, image, index })
      });
      const wrapper = document.getElementById(`previewWrapper${index}`);
      if (wrapper) wrapper.remove();
    }

    let cropper = null;

    document.getElementById("imageInput").addEventListener("change", function (e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function (event) {
        const image = document.getElementById("cropImage");

        if (cropper) {
          cropper.destroy();
          cropper = null;
        }

        image.src = event.target.result;
        document.getElementById("cropModal").style.display = "flex";

        image.onload = function () {
          cropper = new Cropper(image, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
            responsive: true,
          });
        };
      };

      reader.readAsDataURL(file);
      e.target.value = "";
    });

    function cropImage() {
      if (!cropper) {
        alert("Cropper not ready.");
        return;
      }

      const canvas = cropper.getCroppedCanvas({ width: 440, height: 440 });
      if (!canvas) {
        alert("Could not get canvas.");
        return;
      }

      canvas.toBlob(function (blob) {
        const reader = new FileReader();
        reader.onloadend = function () {
          const base64 = reader.result;
          document.getElementById("croppedImages").value = base64;

          const preview = document.createElement("img");
          preview.src = base64;
          preview.style.cssText = "width:80px;height:80px;object-fit:cover;border-radius:6px;border:1px solid #ddd;padding:4px;";
          document.querySelector(".image-upload-container").appendChild(preview);

          closeCrop();
        };
        reader.readAsDataURL(blob);
      }, "image/jpeg", 0.9);
    }

    function closeCrop() {
      document.getElementById("cropModal").style.display = "none";
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
    }
    document.getElementById("cropSaveBtn").addEventListener("click", cropImage);
    document.getElementById("cropCancelBtn").addEventListener("click", closeCrop);
  </script>

</body>
</html>