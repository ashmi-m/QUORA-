      <%- include("../partials/user/profile-sidebar", { user, activePage: 'profile' }) %>


        <div class="profile-content">

          <div id="profileSection" class="profile-section">

            <form id="profileForm">
              <h2>Personal Information</h2>

              <label>Name</label>
              <input type="text" name="name" value="<%= user.name %>" disabled>

              <div class="row">
                <div>
                  <label>Email</label>
                  <input type="email" value="<%= user.email %>" disabled>
                </div>

                <div>
                  <label>Mobile Number</label>
                  <input type="text" name="phone" value="<%= user.phone %>" disabled>
                </div>

              <label>Your Referral Code</label>
<input type="text" value="<%= user.refCode || 'Not generated yet' %>" readonly>
                 
              </div>
              </div>
              <label>Gender</label>
              <select name="gender" id="genderSelect" disabled>
                <option value="">Select</option>
                <option value="Male" <%=user.gender==="Male" ? "selected" : "" %>>Male</option>
                <option value="Female" <%=user.gender==="Female" ? "selected" : "" %>>Female</option>
                <option value="Other" <%=user.gender==="Other" ? "selected" : "" %>>Other</option>
                <option value="Prefer not to say" <%=user.gender==="Prefer not to say" ? "selected" : "" %>>Prefer not
                  to say</option>
              </select>


              <div class="profile-actions">
                <button type="button" id="editProfileBtn">Edit Profile</button>
                <button type="button" id="saveProfileBtn" class="hidden">Save Changes</button>
              </div>
            </form>
          </div>
          <div id="ordersSection" class="profile-section hidden">
            <%- include("./orders", { orders: orders }) %>

          </div>
          <div id="addressSection" class="profile-section hidden">

            <%- include("./manageAddress", { addresses: addresses }) %>
          </div>

        </div>
    </div>

    <footer>© 2025 Quora - All Rights Reserved</footer>
     <script>
function copyRefCode() {
  const input = document.getElementById("refCodeField");
  input.select();
  document.execCommand("copy");
  Swal.fire("Copied!", "Referral code copied to clipboard", "success");
}
</script>
    <script>
      
      document.addEventListener("DOMContentLoaded", () => {

       

        const menuButtons = document.querySelectorAll(".profile-menu button[data-target]");
        const sections = document.querySelectorAll(".profile-section");

        menuButtons.forEach(btn => {
          btn.addEventListener("click", () => {
            sections.forEach(sec => sec.classList.add("hidden"));
            document.getElementById(btn.dataset.target).classList.remove("hidden");

            menuButtons.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
          });
        });



        const hash = window.location.hash;

        if (hash) {
          const targetId = hash.replace("#", "");
          const targetSection = document.getElementById(targetId);
          const targetBtn = document.querySelector(
            `.profile-menu button[data-target="${targetId}"]`
          );

          if (targetSection && targetBtn) {
            sections.forEach(sec => sec.classList.add("hidden"));
            targetSection.classList.remove("hidden");

            menuButtons.forEach(b => b.classList.remove("active"));
            targetBtn.classList.add("active");
          }
        }

        const editBtn = document.getElementById("editProfileBtn");
        const saveBtn = document.getElementById("saveProfileBtn");

        editBtn.addEventListener("click", () => {
          document.querySelector("input[name='name']").disabled = false;
          document.querySelector("input[name='phone']").disabled = false;
          document.getElementById("genderSelect").disabled = false;

          editBtn.classList.add("hidden");
          saveBtn.classList.remove("hidden");
        });

        saveBtn.addEventListener("click", async () => {
          const data = {
            name: document.querySelector("input[name='name']").value,
            phone: document.querySelector("input[name='phone']").value,
            gender: document.getElementById("genderSelect").value
          };

          const res = await fetch("/profile/update", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
          });

          const result = await res.json();

          if (result.success) {
            Swal.fire("Success", "Profile updated", "success")
              .then(() => location.reload());
          } else {
            Swal.fire("Error", result.message || "Update failed", "error");
          }
        });

      });
      
    </script>

  </body>

  </html>