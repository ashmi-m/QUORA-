<%- include("../partials/user/header") %>

  <head>
    <meta charset="UTF-8">
    <title>
      <%= product.productName %> - Quora
    </title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet">
    <style>
      :root {
        --cream: #faf7f4;
        --warm-white: #fff9f5;
        --blush: #f2c4b0;
        --blush-light: #fce8df;
        --rose: #c4765a;
        --deep: #1a1614;
        --muted: #8a7e79;
        --border: #e8ddd8;
        --gold: #c9a96e;
        --success: #3d7a5f;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'DM Sans', sans-serif;
        background: var(--cream);
        color: var(--deep);
      }

      .top-accent {
        height: 3px;
        background: linear-gradient(90deg, var(--blush), var(--rose), var(--gold));
      }


      .breadcrumb {
        padding: 14px 60px;
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .breadcrumb a {
        color: var(--muted);
        text-decoration: none;
      }

      .breadcrumb a:hover {
        color: var(--rose);
      }

      .breadcrumb span {
        margin: 0 8px;
      }

      .product-wrapper {
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px 40px 60px;
      }

      .product-grid {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: 60px;
        align-items: start;
      }

      .gallery {
        position: sticky;
        top: 30px;
      }

      .main-img-wrap {
        position: relative;
        overflow: hidden;
        background: linear-gradient(145deg, #fdf0ea, #f5e6e0);
        border-radius: 4px;
        aspect-ratio: 1;
        cursor: crosshair;
      }

      .main-img-wrap::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 30% 20%, rgba(255, 255, 255, 0.6) 0%, transparent 60%);
        pointer-events: none;
        z-index: 1;
      }

      .main-product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
        display: block;
      }

      .thumbnails {
        display: flex;
        gap: 10px;
        margin-top: 14px;
      }

      .thumbnail-image {
        width: 72px;
        height: 72px;
        object-fit: cover;
        border-radius: 3px;
        cursor: pointer;
        border: 2px solid transparent;
        transition: border-color 0.2s, opacity 0.2s;
        background: linear-gradient(145deg, #fdf0ea, #f5e6e0);
        opacity: 0.75;
      }

      .thumbnail-image:hover,
      .thumbnail-image.active {
        border-color: var(--rose);
        opacity: 1;
      }

      .product-info {
        padding-top: 10px;
      }

      .product-category {
        font-size: 11px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--rose);
        font-weight: 500;
        margin-bottom: 12px;
      }

      .product-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 42px;
        font-weight: 400;
        line-height: 1.15;
        letter-spacing: -0.01em;
        color: var(--deep);
      }

      .product-title-icon {
        font-size: 28px;
        vertical-align: middle;
        margin-left: 6px;
      }

      .divider {
        width: 48px;
        height: 1px;
        background: linear-gradient(90deg, var(--rose), transparent);
        margin: 20px 0;
      }

      .wishlist-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
      }

      #wishlistBtn {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0;
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--muted);
        transition: color 0.2s;
      }

      #wishlistBtn svg {
        width: 22px;
        height: 22px;
        transition: transform 0.3s cubic-bezier(.34, 1.56, .64, 1);
      }

      #wishlistBtn:hover svg {
        transform: scale(1.2);
      }

      #wishlistBtn.active {
        color: #e05c5c;
      }

      #wishlistBtn.active svg path {
        fill: #e05c5c;
        stroke: #e05c5c;
      }

      .wishlist-label {
        font-size: 12px;
        letter-spacing: 0.06em;
        color: var(--muted);
      }

      .desc-box {
        background: var(--warm-white);
        border: 1px solid var(--border);
        border-left: 3px solid var(--blush);
        border-radius: 6px;
        padding: 20px 22px;
        margin: 24px 0;
      }

      .desc-label {
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--rose);
        font-weight: 600;
        margin-bottom: 10px;
      }

      .desc-text {
        font-size: 14.5px;
        line-height: 1.85;
        color: #5a4e49;
      }

      .price-block {
        margin: 28px 0 10px;
      }

      .offer-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--success);
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        padding: 4px 12px;
        border-radius: 20px;
        margin-bottom: 12px;
      }

      .price-main {
        font-family: 'Cormorant Garamond', serif;
        font-size: 48px;
        font-weight: 500;
        color: var(--deep);
        letter-spacing: -0.02em;
        line-height: 1;
      }

      .price-original {
        font-size: 17px;
        color: var(--muted);
        text-decoration: line-through;
        margin-left: 10px;
        font-weight: 300;
      }

      .price-save {
        display: block;
        margin-top: 6px;
        font-size: 13px;
        color: var(--success);
        font-weight: 500;
      }

      .stock-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 16px 0 24px;
      }

      .stock-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 0 3px rgba(61, 122, 95, 0.2);
      }

      .stock-dot.low {
        background: #e09c3d;
        box-shadow: 0 0 0 3px rgba(224, 156, 61, 0.2);
      }

      .stock-dot.out {
        background: #c04444;
        box-shadow: 0 0 0 3px rgba(192, 68, 68, 0.2);
      }

      .stock-text {
        font-size: 13px;
        color: var(--muted);
        letter-spacing: 0.04em;
      }

      #addToCartBtn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 36px;
        background: var(--deep);
        color: #fff;
        border: none;
        border-radius: 3px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: background 0.3s, transform 0.2s;
      }

      #addToCartBtn::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.08) 50%, transparent 100%);
        transform: translateX(-100%);
        transition: transform 0.5s ease;
      }

      #addToCartBtn:hover {
        background: var(--rose);
        transform: translateY(-1px);
      }

      #addToCartBtn:hover::after {
        transform: translateX(100%);
      }

      #addToCartBtn:active {
        transform: translateY(0);
      }

      .cart-icon {
        font-size: 16px;
      }

      .reviews-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 22px;
        padding-top: 22px;
        border-top: 1px solid var(--border);
      }

      .stars {
        display: flex;
        gap: 3px;
      }

      .star {
        width: 16px;
        height: 16px;
        color: var(--gold);
      }

      .review-count {
        font-size: 13px;
        color: var(--muted);
      }

      .related-section {
        margin-top: 70px;
        padding-top: 40px;
        border-top: 1px solid var(--border);
      }

      .section-header {
        display: flex;
        align-items: baseline;
        gap: 16px;
        margin-bottom: 30px;
      }

      .section-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 32px;
        font-weight: 400;
        color: var(--deep);
      }

      .section-line {
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      .related-grid {
        display: flex;
        gap: 18px;
        overflow-x: auto;
        padding-bottom: 12px;
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
      }

      .related-card {
        flex: 0 0 160px;
        text-decoration: none;
        color: inherit;
        group: 1;
      }

      .related-card-inner {
        border: 1px solid var(--border);
        border-radius: 4px;
        overflow: hidden;
        background: var(--warm-white);
        transition: box-shadow 0.3s, transform 0.3s;
      }

      .related-card:hover .related-card-inner {
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        transform: translateY(-4px);
      }

      .related-img-wrap {
        aspect-ratio: 1;
        overflow: hidden;
        background: linear-gradient(145deg, #fdf0ea, #f5e6e0);
      }

      .related-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
      }

      .related-card:hover .related-img-wrap img {
        transform: scale(1.06);
      }

      .related-info {
        padding: 12px 12px 14px;
      }

      .related-name {
        font-size: 12.5px;
        line-height: 1.4;
        color: var(--deep);
        margin-bottom: 6px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .related-offer-badge {
        display: inline-block;
        background: var(--success);
        color: #fff;
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 10px;
        margin-bottom: 4px;
      }

      .related-price {
        font-family: 'Cormorant Garamond', serif;
        font-size: 18px;
        font-weight: 500;
        color: var(--deep);
      }

      .related-price-original {
        font-size: 11px;
        color: var(--muted);
        text-decoration: line-through;
      }

      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(18px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .product-grid {
        animation: fadeUp 0.55s ease both;
      }

      .related-section {
        animation: fadeUp 0.6s 0.1s ease both;
      }

      @media (max-width: 768px) {
        .product-grid {
          grid-template-columns: 1fr;
          gap: 30px;
        }

        .product-wrapper {
          padding: 16px 20px 50px;
        }

        .breadcrumb {
          padding: 12px 20px;
        }

        .product-title {
          font-size: 32px;
        }

        .gallery {
          position: static;
        }
      }
    </style>
  </head>

  <body>

    <div class="top-accent"></div>

    <div class="breadcrumb">
      <a href="/">Home</a><span>›</span>
      <a href="/shop">Shop</a><span>›</span>
      <%= product.productName %>
    </div>

    <div class="product-wrapper">
      <div class="product-grid">
        <div class="gallery">
          <div class="main-img-wrap">
            <img src="<%= product.productImage[0] %>" alt="<%= product.productName %>" class="main-product-image">
          </div>
          <div class="thumbnails">
            <% product.productImage.forEach((img, i)=> { %>
              <img src="<%= img %>" class="thumbnail-image <%= i === 0 ? 'active' : '' %>" data-src="<%= img %>"
                alt="View <%= i+1 %>">
              <% }) %>
          </div>
        </div>
        <div class="product-info">
          <div class="product-category">Eau de Parfum · Luxury Fragrance</div>

          <h1 class="product-title">
            <%= product.productName %>
          </h1>

          <div class="divider"></div>
          <div class="wishlist-row">
            <button id="wishlistBtn" data-id="<%= product._id %>"
              style="color:<%= isWishlisted ? '#e05c5c' : '#bbb' %>;" class="<%= isWishlisted ? 'active' : '' %>">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                stroke-linejoin="round">
                <path
                  d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
              </svg>
            </button>
            <span class="wishlist-label">
              <%= isWishlisted ? 'Saved to Wishlist' : 'Add to Wishlist' %>
            </span>
          </div>
          <div class="desc-box">
            <div class="desc-label">About this fragrance</div>
            <p class="desc-text">
              <%= product.description %>
            </p>
          </div>
          <div class="price-block">
            <% if (product.effectiveOffer> 0) { %>
              <div class="offer-badge">
                ✦ <%= product.effectiveOffer %>% OFF
              </div>
              <div>
                <span class="price-main">₹<%= product.salePrice %></span>
                <span class="price-original">₹<%= product.regularPrice %></span>
              </div>
              <span class="price-save">You save ₹<%= product.regularPrice - product.salePrice %></span>
              <% } else { %>
                <span class="price-main">₹<%= product.regularPrice %></span>
                <% } %>
          </div>
          <div class="stock-row">
            <div class="stock-dot <%= product.quantity <= 3 ? 'low' : '' %> <%= product.quantity === 0 ? 'out' : '' %>">
            </div>
            <span class="stock-text">
              <% if (product.quantity===0) { %>Out of stock
                <% } else if (product.quantity <=3) { %>Only <%= product.quantity %> left — order soon
                    <% } else { %>
                      <%= product.quantity %> in stock
                        <% } %>
            </span>
          </div>
          <button id="addToCartBtn" data-id="<%= product._id %>">
            <span class="cart-icon">🛒</span>
            Add to Cart
          </button>
          <div class="reviews-row">
            <div class="stars">
              <% for(let i=0; i < 5; i++) { %>
                <svg class="star" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
                <% } %>
            </div>
            <span class="review-count">5.0 · 5 Reviews</span>
          </div>

        </div>
      </div>
      <div class="related-section">
        <div class="section-header">
          <h3 class="section-title">You Might Also Love</h3>
          <div class="section-line"></div>
        </div>
        <div class="related-grid">
          <% relatedProducts.forEach(rp=> { %>
            <a href="/product/<%= rp._id %>" class="related-card">
              <div class="related-card-inner">
                <div class="related-img-wrap">
                  <img src="<%= rp.productImage[0] %>" alt="<%= rp.productName %>">
                </div>
                <div class="related-info">
                  <p class="related-name">
                    <%= rp.productName %>
                  </p>
                  <% if (rp.effectiveOffer> 0) { %>
                    <span class="related-offer-badge">
                      <%= rp.effectiveOffer %>% OFF
                    </span><br>
                    <span class="related-price">₹<%= rp.salePrice %></span>
                    <span class="related-price-original"> ₹<%= rp.regularPrice %></span>
                    <% } else { %>
                      <span class="related-price">₹<%= rp.regularPrice %></span>
                      <% } %>
                </div>
              </div>
            </a>
            <% }) %>
        </div>
      </div>

    </div>

    <%- include('../partials/user/footer') %>

      <script>
        document.getElementById("addToCartBtn").addEventListener("click", async () => {
          const productId = document.getElementById("addToCartBtn").dataset.id;
          try {
            const res = await fetch("/cart/add", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ productId })
            });
            const data = await res.json();
            if (res.ok && data.success) {
              Swal.fire({ icon: "success", title: "Added to Cart", timer: 1200, showConfirmButton: false });
              const badge = document.querySelector('a[href="/cart"] .badge');
              if (badge) badge.textContent = Number(badge.textContent || 0) + 1;
            } else {
              Swal.fire("Warning", data.message, "warning");
            }
          } catch (err) {
            Swal.fire("Login Required", "Please login first", "warning");
          }
        });
        document.addEventListener("DOMContentLoaded", function () {
          const mainImage = document.querySelector(".main-product-image");
          const thumbnails = document.querySelectorAll(".thumbnail-image");

          mainImage.addEventListener("mousemove", function (e) {
            const rect = mainImage.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width * 100;
            const y = (e.clientY - rect.top) / rect.height * 100;
            mainImage.style.transformOrigin = `${x}% ${y}%`;
            mainImage.style.transform = "scale(2)";
          });

          mainImage.addEventListener("mouseleave", function () {
            mainImage.style.transform = "scale(1)";
            mainImage.style.transformOrigin = "center center";
          });

          thumbnails.forEach(thumb => {
            thumb.addEventListener("click", function () {
              mainImage.src = this.dataset.src;
              thumbnails.forEach(t => t.classList.remove("active"));
              this.classList.add("active");
            });
          });
          const wishlistBtn = document.getElementById("wishlistBtn");
          if (wishlistBtn) {
            wishlistBtn.addEventListener("click", async () => {
              const productId = wishlistBtn.dataset.id;
              const isActive = wishlistBtn.classList.contains("active");
              try {
                const res = await fetch(isActive ? "/wishlist/remove" : "/wishlist/add", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ productId })
                });
                const data = await res.json();
                if (data.success) {
                  wishlistBtn.classList.toggle("active");
                  wishlistBtn.style.color = isActive ? "#bbb" : "#e05c5c";
                  const label = wishlistBtn.nextElementSibling;
                  if (label) label.textContent = isActive ? "Add to Wishlist" : "Saved to Wishlist";
                  Swal.fire({
                    icon: "success",
                    title: isActive ? "Removed from Wishlist" : "Added to Wishlist",
                    timer: 1000,
                    showConfirmButton: false
                  });
                } else {
                  Swal.fire("Error", data.message || "Something went wrong", "error");
                }
              } catch (err) {
                Swal.fire("Error", "Please login to use wishlist", "error");
              }
            });
          }
        });
      </script>

  </body>

  </html>