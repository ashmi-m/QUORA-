<%- include('../partials/user/header') %>

  <head>
    <link rel="stylesheet" href="../../css/home.css">
    <title>Home - Quora</title>
    <style>
      body {
        background: #fbfafa;
      }

      .products {
        text-align: center;
      }

      .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
        margin-top: 20px;
        justify-items: center;
      }

      .product-card {
        position: relative;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 15px;
        width: 220px;
        background: #fff;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .wishlist-icon {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 22px;
        cursor: pointer;
        color: white;
        transition: 0.3s;
        z-index: 10;
      }

      .wishlist-icon.active {
        color: rgb(250, 127, 127);
      }

      .product-card img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: 6px;
      }

      .product-card h4 {
        font-size: 16px;
        margin: 10px 0;
      }

      .product-card p {
        font-weight: bold;
        color: #333;
        margin: 5px 0;
      }

      .btn-view-details,
      .btn-see-more {
        background: #fe595f;
        color: #fff;
        padding: 8px 12px;
        border: none;
        border-radius: 6px;
      }

      a {
        text-decoration: none;
      }

      .offers-section {
        width: 100%;
        background-color: #fff;
        display: flex;
        justify-content: center;
        padding: 40px 20px;
      }

      .offers-container {
        background-image: url('/images/Flowers brushes cosmetics highlighter Candle Mac.jpeg');
        background-size: cover;
        background-position: center;
        width: 100%;
        max-width: 1200px;
        border-radius: 20px;
        padding: 140px 60px;
        color: #a15e3f;
        text-align: left;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .offers-container h2 {
        font-size: 36px;
        font-weight: bold;
        margin-bottom: 10px;
      }

      .offers-container p {
        font-size: 18px;
        margin-bottom: 20px;
        color: rgba(255, 255, 255, 0.9);
      }

      .offers-container .explore-btn {
        background-color: #a15e3f;
        color: white;
        padding: 12px 24px;
        font-weight: bold;
        border-radius: 10px;
        text-decoration: none;
        display: inline-block;
        width: fit-content;
        transition: background-color 0.3s ease;
      }

      .cart-icon {
        position: absolute;
        top: 10px;
        left: 10px;
        font-size: 20px;
        cursor: pointer;
        color: #555;
        transition: 0.3s;
        z-index: 10;
      }

      .cart-icon:hover {
        color: #f6425d;
      }

      .btn-add-cart {
        background: #f87b7b;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 10px;
      }

      .btn-add-cart:hover {
        background: #b91c1c;
      }

      .offers-container .explore-btn:hover {
        background-color: #8a4b2f;
      }


      .about-hero {
        text-align: center;
        padding: 70px 20px 40px;
      }

      .about-hero h1 {
        font-size: 42px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #1a1a1a;
      }

      .about-image-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 40px 60px;
      }

      .about-image-grid .img-wrap {
        border-radius: 10px;
        overflow: hidden;
      }

      .about-image-grid .img-wrap:nth-child(1) {
        margin-top: 30px;
      }

      .about-image-grid .img-wrap:nth-child(3) {
        margin-top: 50px;
      }

      .about-image-grid img {
        width: 100%;
        height: 320px;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
      }

      .about-image-grid .img-wrap:hover img {
        transform: scale(1.04);
      }


      @media (max-width: 768px) {

        .about-image-grid {
          grid-template-columns: repeat(2, 1fr);
          padding: 0 20px 40px;
        }

        .offers-container {
          padding: 60px 20px;
          text-align: center;
        }

        .offers-container h2 {
          font-size: 28px;
        }

        .offers-container p {
          font-size: 16px;
        }
      }

      @media (max-width: 480px) {


        .product-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 10px;
        }

        .product-card {
          width: 100%;
          padding: 10px;
        }

        .product-card img {
          height: 150px;
        }

        .product-card h4 {
          font-size: 14px;
        }

        .product-card p {
          font-size: 14px;
        }

        .btn-add-cart {
          font-size: 12px;
          padding: 8px;
        }

        .wishlist-icon {
          font-size: 18px;
        }

        .cart-icon {
          font-size: 16px;
        }

        .about-image-grid {
          grid-template-columns: 1fr;
        }

        .about-image-grid img {
          height: 220px;
        }


        .offers-container {
          padding: 40px 15px;
        }

        .offers-container h2 {
          font-size: 22px;
        }

        .offers-container p {
          font-size: 14px;
        }


        .btn-see-more {
          margin-top: 15px;
        }
      }
    </style>
  </head>

  <body>


    <div class="about-image-grid">
      <div class="img-wrap">
        <img src="/images/image 3.png" alt="Perfume Collection">
      </div>
      <div class="img-wrap">
        <img src="/images/lipsick 2.jpeg" alt="Lipstick & Makeup">
      </div>
      <div class="img-wrap">
        <img src="/images/bodyloation.jpeg" alt="Skincare">
      </div>
    </div>


    <section class="products">
      <h2>NEW PRODUCT</h2>
      <div class="product-grid">
        <% if (products && products.length> 0) { %>
          <% products.forEach(product=> { %>
            <div class="product-card">
              <span
                class="wishlist-icon <%= wishlistIds && wishlistIds.includes(product._id.toString()) ? 'active' : '' %>"
                data-id="<%= product._id %>">
                ❤
              </span>
              <a href="/product/<%= product._id %>" class="product-link">


                <img
                  src="<%= product.productImage && product.productImage.length > 0 ? product.productImage[0] : '/images/default.png' %>"
                  alt="<%= product.productName %>">
                <h4>
                  <%= product.productName %>
                </h4>
              </a>
              <p>₹<%= product.salePrice || product.regularPrice %>
              </p>

              <button class="btn-add-cart" data-id="<%= product._id %>">
                <i class="fa fa-shopping-cart"></i> Add to Cart
              </button>

            </div>
            <% }) %>
              <% } else { %>
                <p>No products available</p>
                <% } %>
      </div>
      <a href="/shop"><button class="btn-see-more">View All Products</button></a>
    </section>


    <section class="offers-section">
      <div class="offers-container">
        <h2>GREAT OFFERS</h2>
        <p>Explore the deals and offers</p>
        <a href="/shop" class="explore-btn">EXPLORE</a>
      </div>
    </section>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
      document.addEventListener("DOMContentLoaded", () => {

        document.querySelectorAll(".wishlist-icon").forEach(icon => {
          icon.addEventListener("click", async () => {

            const productId = icon.dataset.id;
            const isActive = icon.classList.contains("active");

            try {
              const res = await fetch(
                isActive ? "/wishlist/remove" : "/wishlist/add",
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ productId })
                }
              );

              const data = await res.json();

              if (data.success || data.added) {
                icon.classList.toggle("active");

                Swal.fire({
                  icon: "success",
                  title: isActive
                    ? "Removed from Wishlist"
                    : "Added to Wishlist",
                  timer: 1000,
                  showConfirmButton: false
                });
              }

            } catch (err) {
              Swal.fire("Login Required", "Please login to use wishlist", "warning");
            }
          });
        });

      });

      const MAX_QTY = 5;
      document.querySelectorAll(".btn-add-cart").forEach(btn => {
        btn.addEventListener("click", async () => {
          const productId = btn.dataset.id;

          try {
            const res = await fetch("/cart/add", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ productId })
            });

            const data = await res.json();

            if (data.success) {
              Swal.fire({
                icon: "success",
                title: data.message,
                timer: 1000,
                showConfirmButton: false
              });

              const badge = document.querySelector('a[href="/cart"] .badge');
              if (badge) badge.textContent = parseInt(badge.textContent || "0") + 1;
            } else {
              Swal.fire({
                icon: "warning",
                title: data.message,
                timer: 1500,
                showConfirmButton: false
              });
            }

          } catch {
            Swal.fire({
              icon: "error",
              title: "Login Required",
              text: "Please login to add products to cart",
            });
          }
        });
      });

    </script>

    <%- include('../partials/user/footer') %>

  </body>