<%- include("../partials/user/header") %>
<link rel="stylesheet" href="/css/checkout.css">

<form action="/checkout/select-address" method="POST">
  <section class="checkout-container">

    <!-- LEFT: ADDRESS -->
    <div class="address-section">
      <div class="section-header">
        <h3>Delivery Address</h3>
        <a href="/add-address?from=checkout" class="btn-primary">
          + Add New Address
        </a>
      </div>

      <% if (addresses.length === 0) { %>
        <div class="empty-state">
          <p>No address found</p>
        </div>
      <% } %>

      <div class="address-list">
        <% addresses.forEach((addr, index) => { %>
          <label class="address-card">
            <input 
              type="radio" 
              name="addressId" 
              value="<%= addr._id %>" 
              <%= index === 0 ? "checked" : "" %>
            >

            <div class="address-info">
              <strong><%= addr.name %></strong>
              <p><%= addr.phone %></p>
              <p class="muted">
                <%= addr.landMark %>, <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %>
              </p>
            </div>
          </label>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a href="/checkout?page=<%= currentPage - 1 %>">&laquo;</a>
          <% } %>

          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="/checkout?page=<%= i %>" 
               class="<%= currentPage === i ? 'active' : '' %>">
              <%= i %>
            </a>
          <% } %>

          <% if (currentPage < totalPages) { %>
            <a href="/checkout?page=<%= currentPage + 1 %>">&raquo;</a>
          <% } %>
        </div>
      <% } %>

    </div>

    <!-- RIGHT: SUMMARY -->
    <div class="summary-section">
      <h3>Order Summary</h3>

      <div class="summary-items">
        <% cart.items.forEach(item => { %>
          <div class="summary-item">
            <span class="item-name">
              <%= item.productName %>
              <span class="qty">× <%= item.quantity %></span>
            </span>
            <span>₹ <%= item.itemTotal.toFixed(2) %></span>
          </div>
        <% }) %>
      </div>

      <hr>

      <div class="summary-row">
        <span>Subtotal</span>
        <span>₹ <%= subtotal.toFixed(2) %></span>
      </div>

      <div class="summary-row">
        <span>Delivery</span>
        <span>₹ <%= deliveryCharge.toFixed(2) %></span>
      </div>

      <div class="summary-row total">
        <span>Total</span>
        <span>₹ <%= total.toFixed(2) %></span>
      </div>

      <button type="submit" class="pay-btn">
        Proceed to Payment
      </button>
    </div>

  </section>
</form>

<script>
  const form = document.querySelector("form");

  form.addEventListener("submit", function (e) {
    const selectedAddress = document.querySelector('input[name="addressId"]:checked');

    if (!selectedAddress) {
      e.preventDefault();
      alert("Please select an address!");
    }
  });
</script>

<%- include("../partials/user/footer") %>