<%- include("../partials/user/header") %>

  <link rel="stylesheet" href="/css/address.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <div class="account-page">


    <ul class="menu">
      <li><a href="/userprofile">Profile Information</a></li>
      <li><a href="/userprofile#ordersSection">My Orders</a></li>
      <li><a href="/logout">Log out</a></li>
    </ul>
    </aside>
    <main class="account-content">

      <div class="address-card">
        <h3 class="card-title">Add a new address</h3>

        <form id="addressForm" action="/address/add" method="POST" novalidate>

         <div class="form-row">
         <div class="form-group">
<label>Name</label>
<input 
  name="name"
  id="name"
  pattern="[A-Za-z ]{3,}"
  title="Name must contain at least 3 letters"
  required
>
<span class="error-text" id="nameError"></span>
</div>

               <div class="form-group">
            <label>Mobile Number</label>
            <input 
              name="mobile"
              id="mobile"
              maxlength="10"
              pattern="[6-9][0-9]{9}"
              inputmode="numeric"
              required
            >
             <span class="error-text" id="mobileError"></span>
          </div>
        </div>

         <div class="form-row">
          <div class="form-group">
            <label>Pincode</label>
            <input 
              name="pincode"
              id="pincode"
              maxlength="6"
              pattern="[0-9]{6}"
              inputmode="numeric"
              required
            >
            <span class="error-text" id="pincodeError"></span>
          </div>
<div class="form-group">
<label>Locality</label>
<input name="locality" id="locality" required>
<span class="error-text" id="localityError"></span>
</div>
          </div>
<div class="form-group">
<label>Address</label>
<textarea name="address" id="address" required></textarea>
<span class="error-text" id="addressError"></span>
</div>

          <div class="form-row">
            <div class="form-group">
              <label>City / District</label>
              <input name="city" id="city" readonly required>
              <span class="error-text" id="cityError"></span>
            </div>

            <div class="form-group">
              <label>State</label>
              <input name="state" id="state" readonly required>
              <span class="error-text" id="stateError"></span>
            </div>
          </div>

           <div class="form-group">
<label>Landmark (optional)</label>
<input name="landmark" id="landmark">
<span class="error-text" id="landmarkError"></span>
</div>

          <div class="address-type">
            <label><input type="radio" name="type" value="Home" checked> Home</label>
            <label><input type="radio" name="type" value="Work"> Work</label>
          </div>

          <div class="btn-row">
            <button class="save-btn">Save</button>
            <a href="/userprofile/manage-address" class="cancel-btn">Cancel</a>
          </div>

        </form>
      </div>
    </main>
  </div>

  <script>
    document.getElementById("pincode").addEventListener("keyup", function () {
      const pincode = this.value.trim();

      if (pincode.length === 6) {
        fetch(`https://api.postalpincode.in/pincode/${pincode}`)
          .then(res => res.json())
          .then(data => {
            if (data[0].Status === "Success") {
              const postOffice = data[0].PostOffice[0];
              document.getElementById("city").value = postOffice.District;
              document.getElementById("state").value = postOffice.State;
            } else {
              Swal.fire("Invalid Pincode", "Pincode not found", "error");
            }
          })
          .catch(() => {
            Swal.fire("Error", "Unable to fetch location details", "error");
          });
      }
    });
document.getElementById("addressForm").addEventListener("submit", function(e){

let valid = true;

function setError(id,message){
  const input = document.getElementById(id)
  const error = document.getElementById(id+"Error")

  input.classList.add("input-error")
  error.innerText = message
  valid=false
}

function clearError(id){
  const input = document.getElementById(id)
  const error = document.getElementById(id+"Error")

  input.classList.remove("input-error")
  error.innerText=""
}

const name = document.getElementById("name").value.trim()
const mobile = document.getElementById("mobile").value.trim()
const pincode = document.getElementById("pincode").value.trim()
const locality = document.getElementById("locality").value.trim()
const address = document.getElementById("address").value.trim()
const city = document.getElementById("city").value.trim()
const state = document.getElementById("state").value.trim()

clearError("name")
clearError("mobile")
clearError("pincode")
clearError("locality")
clearError("address")
clearError("city")
clearError("state")

if(name.length<3){
  setError("name","Name must contain at least 3 letters")
}
if(!/^[6-9]\d{9}$/.test(mobile)){
  setError("mobile","Enter valid 10 digit mobile number")
}
if(!/^\d{6}$/.test(pincode)){
  setError("pincode","Enter valid 6 digit pincode")
}
if(locality===""){
  setError("locality","Locality is required")
}
if(address===""){
  setError("address","Address is required")
}
if(city===""){
  setError("city","City is required")
}
if(state===""){
  setError("state","State is required")
}
if(!valid){
  e.preventDefault()
}
})
    const params = new URLSearchParams(window.location.search);
    if (params.get("saved") === "true") {
      Swal.fire({
        icon: "success",
        title: "Saved!",
        text: "Address added successfully",
        timer: 2000,
        showConfirmButton: false
      }).then(() => {
        window.history.replaceState({}, document.title, "/add-address");
      });
    }
  </script>