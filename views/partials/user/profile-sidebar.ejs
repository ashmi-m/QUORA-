<div class="profile-sidebar">
  <div class="profile-image-box">
  <% if (user.profileImage && user.profileImage.trim() !== "") { %>
  <img src="<%= user.profileImage %>" 
       alt="Profile Image" 
       id="profilePreview"
       onerror="this.style.display='none'; document.getElementById('avatarFallback').style.display='flex';">
  <div class="avatar-placeholder" id="avatarFallback" style="display:none;"><%= user.name.charAt(0).toUpperCase() %></div>
<% } else { %>
  <div class="avatar-placeholder" id="profilePreview"><%= user.name.charAt(0).toUpperCase() %></div>
<% } %>

  <input type="file" id="profileImageInput" hidden>
  <button type="button" id="changeImageBtn">Change Photo</button>
</div>

  <h3>Hello 👋 <%= user?.name %></h3>

  <div class="profile-menu">
    <a href="/userprofile">
      <button class="<%= activePage === 'profile' ? 'active' : '' %>">Profile Information</button>
    </a>
    <a href="/orders">
      <button class="<%= activePage === 'orders' ? 'active' : '' %>">My Orders</button>
    </a>
    <a href="/manage-address">
      <button class="<%= activePage === 'address' ? 'active' : '' %>">Manage Address</button>
    </a>
    <a href="/wallet">
      <button class="<%= activePage === 'wallet' ? 'active' : '' %>">My Wallet</button>
    </a>
    <a>
      <button type="button" id="logoutBtn">Logout</button>
    </a>
    <a href="/userprofile/privacy-security">
      <button class="<%= activePage === 'security' ? 'active' : '' %>">Privacy & Security</button>
    </a>
  </div>
</div>
<script>
document.addEventListener("DOMContentLoaded", () => {

    const changeBtn = document.getElementById("changeImageBtn");
    const imageInput = document.getElementById("profileImageInput");
    const preview = document.getElementById("profilePreview");
    const logoutBtn = document.getElementById("logoutBtn");

    /* ---- Prevent event duplication ---- */
    if (changeBtn && !changeBtn.dataset.listenerAdded) {

        changeBtn.dataset.listenerAdded = "true";

        changeBtn.addEventListener("click", () => {
            imageInput.click();
        });

        imageInput.addEventListener("change", async () => {

            const file = imageInput.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append("profileImage", file);

            try {

                const res = await fetch("/profile/upload-image", {
                    method: "PUT",
                    body: formData
                });

                const result = await res.json();

                if (result.success) {

                    const preview = document.getElementById("profilePreview");

                    if (preview.tagName === "IMG") {
                        preview.src = result.image;
                    } else {
                        const img = document.createElement("img");
                        img.src = result.image;
                        img.id = "profilePreview";
                        preview.replaceWith(img);
                    }

                    Swal.fire("Success", "Profile image updated", "success");

                } else {
                    Swal.fire("Error", "Upload failed", "error");
                }

            } catch (err) {
                Swal.fire("Error", "Something went wrong", "error");
            }

        });
    }

    /* ---- Logout ---- */

    if (logoutBtn && !logoutBtn.dataset.listenerAdded) {

        logoutBtn.dataset.listenerAdded = "true";

        logoutBtn.addEventListener("click", () => {

            Swal.fire({
                title: "Are you sure?",
                text: "You will be logged out of your account",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, Logout"
            }).then((result) => {

                if (result.isConfirmed) {
                    window.location.href = "/logout";
                }

            });

        });
    }

});
</script>